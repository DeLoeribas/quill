# Fallback hardening for shared hosts where the document root can't be
# pointed above this repo. If Apache/LiteSpeed serves this directory at all,
# deny every request to it outright.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
